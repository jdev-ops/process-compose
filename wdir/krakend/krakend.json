{
  "$schema": "https://www.krakend.io/schema/v2.5/krakend.json",
  "version": 3,
  "name": "My lovely gateway",
  "port": 8080,
  "cache_ttl": "3600s",
  "timeout": "3s",
  "extra_config": {
    "telemetry/logging": {
      "level": "DEBUG",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    },
    "telemetry/metrics": {
      "collection_time": "60s",
      "proxy_disabled": false,
      "router_disabled": false,
      "backend_disabled": false,
      "endpoint_disabled": false,
      "listen_address": ":8090"
    },
    "security/cors": {
      "allow_origins": [
        "http://192.168.99.100:3000",
        "http://localhost:3000"
      ],
      "allow_methods": [
        "POST",
        "GET"
      ],
      "allow_headers": [
        "Origin",
        "Authorization",
        "Content-Type"
      ],
      "expose_headers": [
        "Content-Length"
      ],
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/v1/auth",
      "method": "POST",
      "extra_config": {
        "auth/signer": {
          "alg": "RS256",
          "jwk_local_path": "./jwks-priv.json",
          "kid": "id-1",
          "keys_to_sign": [
            "access_token"
          ],
          "jwk_fingerprints": [
            "MGRiTlR3c2hkblBqdlpTekY2VXQ5Tjd3U2JpUC1VczNjbTFMcTljWFNLbw=="
          ],
          "disable_jwk_security": true
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/auth",
          "host": [
            "http://localhost:8000"
          ]
        }
      ]
    }
  ]
}
